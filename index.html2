<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lucky Ticket — Win Big</title>

<!-- Firebase SDKs -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

<style>
:root {
  --navy: #0a0e27;
  --navy2: #0f1535;
  --navy3: #151c45;
  --purple: #6c3fc5;
  --purple2: #8b5cf6;
  --purple3: #a78bfa;
  --gold: #f59e0b;
  --gold2: #fbbf24;
  --text: #e2e8f0;
  --text2: #94a3b8;
  --text3: #64748b;
  --success: #10b981;
  --danger: #ef4444;
  --card: rgba(21,28,69,0.9);
  --border: rgba(108,63,197,0.3);
  --radius: 16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{font-family:'Segoe UI',system-ui,sans-serif;background:var(--navy);color:var(--text);min-height:100vh}
body{max-width:480px;margin:0 auto;padding:env(safe-area-inset-top,0) env(safe-area-inset-right,0) env(safe-area-inset-bottom,0) env(safe-area-inset-left,0)}

/* NAV */
.nav{position:sticky;top:0;z-index:100;background:rgba(10,14,39,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-size:20px;font-weight:700;background:linear-gradient(135deg,var(--purple2),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-actions{display:flex;gap:8px}
.btn-nav{background:transparent;border:1px solid var(--border);color:var(--text2);padding:7px 14px;border-radius:8px;font-size:13px;cursor:pointer;transition:all .2s}
.btn-nav:hover,.btn-nav.active{background:var(--purple);border-color:var(--purple);color:#fff}
.btn-nav-primary{background:var(--purple);border-color:var(--purple);color:#fff}

/* PAGES */
.page{display:none;padding:16px;padding-bottom:80px;animation:fadeIn .3s ease}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* HERO */
.hero{text-align:center;padding:32px 0 24px}
.hero-badge{display:inline-block;background:rgba(108,63,197,0.2);border:1px solid var(--border);border-radius:20px;padding:4px 14px;font-size:12px;color:var(--purple3);margin-bottom:16px;letter-spacing:.5px}
.hero h1{font-size:32px;font-weight:800;line-height:1.1;margin-bottom:12px}
.hero h1 span{background:linear-gradient(135deg,var(--purple2),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{font-size:15px;color:var(--text2);max-width:320px;margin:0 auto 24px;line-height:1.6}
.hero-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}

/* BUTTONS */
.btn{padding:12px 24px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none;transition:all .2s;display:inline-flex;align-items:center;gap:8px}
.btn-primary{background:linear-gradient(135deg,var(--purple),var(--purple2));color:#fff;box-shadow:0 4px 20px rgba(108,63,197,0.4)}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(108,63,197,0.5)}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text2)}
.btn-outline:hover{border-color:var(--purple2);color:var(--purple2)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#f97316);color:#fff;box-shadow:0 4px 20px rgba(245,158,11,0.3)}
.btn-block{width:100%;justify-content:center}
.btn-sm{padding:8px 16px;font-size:13px;border-radius:8px}
.btn-danger{background:var(--danger);color:#fff}
.btn-success{background:var(--success);color:#fff}

/* CARDS */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:16px;backdrop-filter:blur(8px)}
.card-sm{padding:14px 16px}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.card-title{font-size:16px;font-weight:600}
.card-title-sm{font-size:14px;font-weight:600}

/* STATS GRID */
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.stat-card{background:rgba(21,28,69,0.8);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center}
.stat-num{font-size:24px;font-weight:700;color:var(--purple2)}
.stat-label{font-size:12px;color:var(--text2);margin-top:2px}

/* COMPETITION PLANS */
.plans-grid{display:grid;gap:12px}
.plan-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
.plan-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(108,63,197,0.1),transparent);opacity:0;transition:opacity .25s}
.plan-card:hover::before{opacity:1}
.plan-card:hover{border-color:var(--purple2);transform:translateY(-2px)}
.plan-card.featured{border-color:var(--gold);background:rgba(245,158,11,0.08)}
.plan-header{display:flex;align-items:center;justify-content:space-between}
.plan-name{font-size:15px;font-weight:600}
.plan-prize{font-size:22px;font-weight:800;color:var(--gold)}
.plan-badge{font-size:11px;padding:3px 10px;border-radius:20px;font-weight:600}
.plan-badge.open{background:rgba(16,185,129,0.2);color:var(--success)}
.plan-badge.closed{background:rgba(239,68,68,0.15);color:var(--danger)}
.plan-badge.pending{background:rgba(245,158,11,0.15);color:var(--gold)}
.plan-meta{display:flex;align-items:center;gap:16px;margin-top:10px;font-size:13px;color:var(--text2)}
.plan-progress-bar{margin-top:10px;height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden}
.plan-progress-fill{height:100%;background:linear-gradient(90deg,var(--purple),var(--purple2));border-radius:3px;transition:width .5s}

/* TICKET */
.ticket{background:linear-gradient(135deg,var(--navy2),var(--navy3));border:1.5px dashed rgba(108,63,197,0.5);border-radius:12px;padding:16px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;position:relative}
.ticket::before{content:'';position:absolute;left:-1px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:var(--navy);border-radius:50%}
.ticket::after{content:'';position:absolute;right:-1px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:var(--navy);border-radius:50%}
.ticket-num{font-size:22px;font-weight:800;letter-spacing:4px;color:var(--purple2)}
.ticket-info{font-size:12px;color:var(--text2);text-align:right}
.ticket-plan{font-weight:600;color:var(--text);font-size:14px}

/* FORMS */
.form-group{margin-bottom:16px}
.form-label{font-size:13px;color:var(--text2);margin-bottom:6px;display:block}
.form-input{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:15px;color:var(--text);outline:none;transition:border-color .2s}
.form-input:focus{border-color:var(--purple2)}
.form-input::placeholder{color:var(--text3)}
.form-error{font-size:12px;color:var(--danger);margin-top:4px}
.form-success{font-size:12px;color:var(--success);margin-top:4px}

/* SECTIONS */
.section-title{font-size:20px;font-weight:700;margin-bottom:4px}
.section-sub{font-size:13px;color:var(--text2);margin-bottom:20px}
.divider{height:1px;background:var(--border);margin:20px 0}

/* WINNER BADGE */
.winner-banner{background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(108,63,197,0.15));border:1px solid var(--gold);border-radius:var(--radius);padding:20px;text-align:center;margin-bottom:16px}
.winner-trophy{font-size:40px;margin-bottom:8px}
.winner-name{font-size:18px;font-weight:700;color:var(--gold)}
.winner-coins{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,0.15);border-radius:20px;padding:4px 14px;font-size:14px;font-weight:600;color:var(--gold);margin-top:8px}

/* NOTIFICATION */
.notif{background:rgba(108,63,197,0.12);border-left:3px solid var(--purple2);border-radius:8px;padding:12px 14px;margin-bottom:10px}
.notif-title{font-size:14px;font-weight:600}
.notif-time{font-size:11px;color:var(--text3);margin-top:2px}

/* BOTTOM NAV */
.bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:rgba(10,14,39,0.97);backdrop-filter:blur(12px);border-top:1px solid var(--border);display:flex;padding:8px 0;padding-bottom:calc(8px + env(safe-area-inset-bottom,0));z-index:100}
.bnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;padding:6px 4px;transition:all .2s;color:var(--text3);font-size:10px}
.bnav-item svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.bnav-item.active{color:var(--purple2)}
.bnav-item.active svg{stroke:var(--purple2)}

/* BADGE */
.badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600}
.badge-purple{background:rgba(108,63,197,0.2);color:var(--purple3)}
.badge-green{background:rgba(16,185,129,0.15);color:var(--success)}
.badge-gold{background:rgba(245,158,11,0.15);color:var(--gold)}
.badge-red{background:rgba(239,68,68,0.15);color:var(--danger)}

/* USER ID */
.uid-box{background:rgba(108,63,197,0.1);border:1px solid var(--border);border-radius:10px;padding:12px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;margin-bottom:16px}
.uid-label{font-size:11px;color:var(--text2)}
.uid-val{font-size:16px;font-weight:700;letter-spacing:2px;color:var(--purple2)}

/* PROFILE AVATAR */
.avatar{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--purple2));display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff;margin:0 auto 12px;border:3px solid var(--border)}

/* TOAST */
.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%) translateY(-10px);background:rgba(21,28,69,0.98);border:1px solid var(--border);border-radius:10px;padding:12px 20px;font-size:14px;z-index:999;opacity:0;transition:all .3s;pointer-events:none;white-space:nowrap;backdrop-filter:blur(10px)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* LOADING */
.spinner{width:40px;height:40px;border:3px solid var(--border);border-top-color:var(--purple2);border-radius:50%;animation:spin 1s linear infinite;margin:40px auto;display:block}
@keyframes spin{to{transform:rotate(360deg)}}

/* QUIZ */
.quiz-option{background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:10px;padding:12px 14px;cursor:pointer;margin-bottom:8px;transition:all .2s;font-size:15px}
.quiz-option:hover{border-color:var(--purple2);background:rgba(108,63,197,0.1)}
.quiz-option.correct{border-color:var(--success);background:rgba(16,185,129,0.1);color:var(--success)}
.quiz-option.wrong{border-color:var(--danger);background:rgba(239,68,68,0.08);color:var(--danger)}
.quiz-score{font-size:48px;font-weight:800;color:var(--gold);text-align:center;margin:16px 0 4px}

/* EMPTY STATE */
.empty{text-align:center;padding:40px 20px;color:var(--text3)}
.empty-icon{font-size:40px;margin-bottom:12px;opacity:.5}

/* SUPPORT */
.support-item{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:10px;cursor:pointer;display:flex;align-items:center;justify-content:space-between}
.support-item:hover{border-color:var(--purple2)}

/* HISTORY TABLE */
.history-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:14px}
.history-row:last-child{border-bottom:none}

/* MODAL OVERLAY */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:200;display:none;align-items:flex-end;justify-content:center}
.modal-overlay.show{display:flex}
.modal-sheet{background:var(--navy2);border:1px solid var(--border);border-radius:24px 24px 0 0;padding:24px 20px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-handle{width:40px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 20px}
.modal-title{font-size:18px;font-weight:700;margin-bottom:16px}

.text-muted{color:var(--text2);font-size:13px}
.text-xs{font-size:12px}
.mt-8{margin-top:8px}
.mt-12{margin-top:12px}
.mt-16{margin-top:16px}
.mt-24{margin-top:24px}
.flex{display:flex}
.items-center{align-items:center}
.justify-between{justify-content:space-between}
.gap-8{gap:8px}
.gap-12{gap:12px}
.w-full{width:100%}
.text-center{text-align:center}
.font-bold{font-weight:700}
.text-gold{color:var(--gold)}
.text-green{color:var(--success)}
.text-red{color:var(--danger)}
.text-purple{color:var(--purple2)}
</style>
</head>
<body>

<!-- TOP NAV -->
<nav class="nav">
  <div class="nav-logo">🎫 Lucky Ticket</div>
  <div class="nav-actions" id="navActions">
    <button class="btn-nav" onclick="showAuthPage('login')">Login</button>
    <button class="btn-nav btn-nav-primary" onclick="showAuthPage('register')">Join</button>
  </div>
</nav>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- PAGE: HOME -->
<div class="page active" id="page-home">
  <div class="hero">
    <div class="hero-badge">🎯 Skill-Based Competition</div>
    <h1>Win <span>Amazing Prizes</span> Every Round</h1>
    <p>Join competitions, answer quiz questions, beat the leaderboard, and claim your prize points.</p>
    <div class="hero-btns">
      <button class="btn btn-primary" onclick="showAuthPage('register')">Get Started Free</button>
      <button class="btn btn-outline" onclick="scrollToPlans()">View Plans</button>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card"><div class="stat-num" id="homeStatPlayers">—</div><div class="stat-label">Players Registered</div></div>
    <div class="stat-card"><div class="stat-num" id="homeStatComps">—</div><div class="stat-label">Competitions Run</div></div>
    <div class="stat-card"><div class="stat-num" id="homeStatWinners">—</div><div class="stat-label">Total Winners</div></div>
    <div class="stat-card"><div class="stat-num" id="homeStatActive">—</div><div class="stat-label">Active Now</div></div>
  </div>

  <!-- LATEST WINNER -->
  <div id="latestWinnerSection" style="display:none">
    <div class="card-title" style="margin-bottom:12px">🏆 Latest Winner</div>
    <div class="winner-banner" id="latestWinnerBanner"></div>
  </div>

  <!-- PLANS -->
  <div id="plansSection">
    <div class="section-title">Competition Plans</div>
    <div class="section-sub">Choose a plan — answer quiz questions — win prize points</div>
    <div class="plans-grid" id="homePlansList">
      <div class="spinner"></div>
    </div>
  </div>

  <div class="card" style="margin-top:16px">
    <div class="card-title">ℹ️ How It Works</div>
    <div style="margin-top:12px;display:flex;flex-direction:column;gap:14px">
      <div class="flex gap-12 items-center"><div style="width:32px;height:32px;background:var(--purple);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">1</div><div class="text-muted">Register and get your unique player ID and a six-digit ticket number</div></div>
      <div class="flex gap-12 items-center"><div style="width:32px;height:32px;background:var(--purple);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">2</div><div class="text-muted">Join a competition of your choice — 20 participants per round</div></div>
      <div class="flex gap-12 items-center"><div style="width:32px;height:32px;background:var(--purple);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">3</div><div class="text-muted">Answer skill-based quiz questions when the round closes</div></div>
      <div class="flex gap-12 items-center"><div style="width:32px;height:32px;background:var(--purple);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">4</div><div class="text-muted">Top scorer wins virtual prize points — results verified by admin</div></div>
    </div>
    <div style="margin-top:16px;padding:12px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:10px;font-size:12px;color:var(--gold)">
      ⚠️ Prize points are simulated, non-cash promotional rewards. No cash, bank details, UPI PINs, or card info are collected or required.
    </div>
  </div>
</div>

<!-- PAGE: AUTH -->
<div class="page" id="page-auth">
  <div style="max-width:360px;margin:20px auto">
    <div class="text-center" style="margin-bottom:24px">
      <div style="font-size:40px;margin-bottom:8px">🎫</div>
      <div class="section-title" id="authTitle">Create Account</div>
    </div>

    <!-- REGISTER FORM -->
    <div id="registerForm">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input class="form-input" id="regName" type="text" placeholder="Your full name">
      </div>
      <div class="form-group">
        <label class="form-label">Mobile Number</label>
        <input class="form-input" id="regPhone" type="tel" placeholder="+91 XXXXXXXXXX">
      </div>
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input class="form-input" id="regEmail" type="email" placeholder="your@email.com">
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" id="regPass" type="password" placeholder="Minimum 6 characters">
        <div class="form-error" id="regError"></div>
      </div>
      <button class="btn btn-primary btn-block" onclick="doRegister()">Create Account</button>
      <div class="text-center mt-16 text-muted">Already have an account? <span style="color:var(--purple2);cursor:pointer" onclick="showAuthPage('login')">Sign in</span></div>
    </div>

    <!-- LOGIN FORM -->
    <div id="loginForm" style="display:none">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input class="form-input" id="loginEmail" type="email" placeholder="your@email.com">
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" id="loginPass" type="password" placeholder="Your password">
        <div class="form-error" id="loginError"></div>
      </div>
      <button class="btn btn-primary btn-block" onclick="doLogin()">Sign In</button>
      <div class="text-center mt-16 text-muted">New to Lucky Ticket? <span style="color:var(--purple2);cursor:pointer" onclick="showAuthPage('register')">Register</span></div>
    </div>
  </div>
</div>

<!-- PAGE: COMPETITIONS (logged in) -->
<div class="page" id="page-competitions">
  <div class="section-title">Competitions</div>
  <div class="section-sub">Join an open round and play to win</div>
  <div class="plans-grid" id="competitionsList">
    <div class="spinner"></div>
  </div>
</div>

<!-- PAGE: MY TICKETS -->
<div class="page" id="page-tickets">
  <div class="section-title">My Tickets</div>
  <div class="section-sub">Your competition entries and ticket history</div>
  <div id="myTicketsList"><div class="spinner"></div></div>
</div>

<!-- PAGE: PROFILE -->
<div class="page" id="page-profile">
  <div class="card text-center">
    <div class="avatar" id="profileAvatar">?</div>
    <div style="font-size:18px;font-weight:700" id="profileName">—</div>
    <div class="text-muted mt-8" id="profilePhone">—</div>
    <div class="uid-box mt-12" onclick="copyUID()">
      <div><div class="uid-label">Your Player ID</div><div class="uid-val" id="profileUID">—</div></div>
      <div style="font-size:12px;color:var(--text3)">Tap to copy</div>
    </div>
    <div class="flex gap-8" style="justify-content:center">
      <span class="badge badge-green" id="profileBadge">Active</span>
      <span class="badge badge-purple" id="profileCoins">🪙 0 Coins</span>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Competition History</div>
    <div id="compHistory"><div class="text-muted text-xs mt-8">No competitions yet.</div></div>
  </div>

  <div class="card">
    <div class="card-title">Notifications</div>
    <div id="notifList"><div class="text-muted text-xs mt-8">No notifications.</div></div>
  </div>

  <div class="card">
    <div class="card-title">Customer Support</div>
    <div class="support-item mt-8" onclick="showSupport('faq')"><span>❓ FAQs</span><span style="color:var(--text3)">›</span></div>
    <div class="support-item" onclick="showSupport('contact')"><span>💬 Contact Us</span><span style="color:var(--text3)">›</span></div>
    <div class="support-item" onclick="showSupport('rules')"><span>📋 Competition Rules</span><span style="color:var(--text3)">›</span></div>
  </div>

  <button class="btn btn-outline btn-block" onclick="doLogout()">Sign Out</button>
</div>

<!-- BOTTOM NAV (logged in only) -->
<div class="bottom-nav" id="bottomNav" style="display:none">
  <div class="bnav-item active" onclick="switchTab('competitions','home')" id="bnav-home">
    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Home
  </div>
  <div class="bnav-item" onclick="switchTab('competitions','comps')" id="bnav-comps">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>Compete
  </div>
  <div class="bnav-item" onclick="switchTab('tickets','tickets')" id="bnav-tickets">
    <svg viewBox="0 0 24 24"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>Tickets
  </div>
  <div class="bnav-item" onclick="switchTab('profile','profile')" id="bnav-profile">
    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Profile
  </div>
</div>

<!-- QUIZ MODAL -->
<div class="modal-overlay" id="quizModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">🧠 Quiz Time!</div>
    <div id="quizContent"></div>
  </div>
</div>

<!-- JOIN CONFIRM MODAL -->
<div class="modal-overlay" id="joinModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">Join Competition</div>
    <div id="joinModalContent"></div>
  </div>
</div>

<!-- SUPPORT MODAL -->
<div class="modal-overlay" id="supportModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title" id="supportModalTitle">Support</div>
    <div id="supportModalContent"></div>
    <button class="btn btn-outline btn-block mt-16" onclick="closeModal('supportModal')">Close</button>
  </div>
</div>

<script>
// ===================== FIREBASE CONFIG =====================
// REPLACE THIS ENTIRE OBJECT with your Firebase project config
// Get it from Firebase Console → Project Settings → Your Apps → Web App
const firebaseConfig = {
  apiKey: "AIzaSyD6AMNbkUgBIZgRrM6z8qXlpvo_q07g7cc",
  authDomain: "luckyticket-f6fcc.firebaseapp.com",
  projectId: "luckyticket-f6fcc",
  storageBucket: "luckyticket-f6fcc.firebasestorage.app",
  messagingSenderId: "311920974005",
  appId: "1:311920974005:web:20c28779a011135466c6fc"
};

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

// ===================== STATE =====================
let currentUser = null;
let currentUserData = null;
let activeTab = 'home';

// ===================== AUTH LISTENER =====================
auth.onAuthStateChanged(async (user) => {
  if (user) {
    currentUser = user;
    const doc = await db.collection('users').doc(user.uid).get();
    if (doc.exists) {
      currentUserData = doc.data();
      // Check if blocked
      if (currentUserData.blocked) {
        showToast('Your account has been suspended. Contact support.');
        await auth.signOut();
        return;
      }
      showLoggedInUI();
      loadHomeStats();
      loadCompetitions();
      loadMyTickets();
      loadProfile();
      loadNotifications();
      // Update last seen
      db.collection('users').doc(user.uid).update({ lastSeen: firebase.firestore.FieldValue.serverTimestamp() });
    }
  } else {
    currentUser = null;
    currentUserData = null;
    showLoggedOutUI();
    loadHomeStats();
    loadPublicPlans();
  }
});

// ===================== UI HELPERS =====================
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + id)?.classList.add('active');
}

function switchTab(page, tab) {
  showPage(page);
  document.querySelectorAll('.bnav-item').forEach(b => b.classList.remove('active'));
  document.getElementById('bnav-' + tab)?.classList.add('active');
  activeTab = tab;
  if (tab === 'tickets') loadMyTickets();
  if (tab === 'profile') { loadProfile(); loadNotifications(); }
}

function showLoggedInUI() {
  document.getElementById('navActions').innerHTML = `
    <span style="font-size:12px;color:var(--text2)">${currentUserData?.name?.split(' ')[0] || 'Player'}</span>
  `;
  document.getElementById('bottomNav').style.display = 'flex';
  showPage('competitions');
}

function showLoggedOutUI() {
  document.getElementById('navActions').innerHTML = `
    <button class="btn-nav" onclick="showAuthPage('login')">Login</button>
    <button class="btn-nav btn-nav-primary" onclick="showAuthPage('register')">Join</button>
  `;
  document.getElementById('bottomNav').style.display = 'none';
  showPage('home');
}

function showAuthPage(mode) {
  showPage('auth');
  document.getElementById('registerForm').style.display = mode === 'register' ? 'block' : 'none';
  document.getElementById('loginForm').style.display = mode === 'login' ? 'block' : 'none';
  document.getElementById('authTitle').textContent = mode === 'register' ? 'Create Account' : 'Welcome Back';
}

function scrollToPlans() {
  document.getElementById('plansSection').scrollIntoView({ behavior: 'smooth' });
}

function showToast(msg, type = 'info') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.borderColor = type === 'error' ? 'var(--danger)' : type === 'success' ? 'var(--success)' : 'var(--border)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
}

function openModal(id) {
  document.getElementById(id).classList.add('show');
}

// ===================== GENERATE UNIQUE ID =====================
function generateUID() {
  return Math.random().toString(36).substr(2, 8).toUpperCase();
}

function generateTicketNumber() {
  return String(Math.floor(100000 + Math.random() * 900000));
}

// ===================== AUTH ACTIONS =====================
async function doRegister() {
  const name = document.getElementById('regName').value.trim();
  const phone = document.getElementById('regPhone').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const pass = document.getElementById('regPass').value;
  const err = document.getElementById('regError');
  err.textContent = '';

  if (!name || !phone || !email || !pass) { err.textContent = 'All fields are required.'; return; }
  if (pass.length < 6) { err.textContent = 'Password must be at least 6 characters.'; return; }

  try {
    const cred = await auth.createUserWithEmailAndPassword(email, pass);
    const uid = cred.user.uid;
    const playerId = generateUID();

    await db.collection('users').doc(uid).set({
      name, phone, email,
      playerId,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      blocked: false,
      coins: 0,
      totalWins: 0,
      totalEntries: 0,
      lastSeen: firebase.firestore.FieldValue.serverTimestamp()
    });

    // Increment global stats
    await db.collection('stats').doc('global').set({
      totalUsers: firebase.firestore.FieldValue.increment(1)
    }, { merge: true });

    showToast('Account created! Welcome to Lucky Ticket 🎫', 'success');
  } catch(e) {
    err.textContent = friendlyError(e.code);
  }
}

async function doLogin() {
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPass').value;
  const err = document.getElementById('loginError');
  err.textContent = '';
  if (!email || !pass) { err.textContent = 'Enter email and password.'; return; }
  try {
    await auth.signInWithEmailAndPassword(email, pass);
  } catch(e) {
    err.textContent = friendlyError(e.code);
  }
}

async function doLogout() {
  await auth.signOut();
  showToast('Signed out successfully.');
  showPage('home');
}

function friendlyError(code) {
  const map = {
    'auth/email-already-in-use': 'Email already registered.',
    'auth/invalid-email': 'Invalid email address.',
    'auth/weak-password': 'Password is too weak.',
    'auth/user-not-found': 'No account found with this email.',
    'auth/wrong-password': 'Incorrect password.',
    'auth/invalid-credential': 'Incorrect email or password.',
    'auth/too-many-requests': 'Too many attempts. Try again later.'
  };
  return map[code] || 'Something went wrong. Try again.';
}

// ===================== HOME STATS =====================
async function loadHomeStats() {
  try {
    const snap = await db.collection('stats').doc('global').get();
    const data = snap.data() || {};
    document.getElementById('homeStatPlayers').textContent = data.totalUsers || 0;
    document.getElementById('homeStatComps').textContent = data.totalCompetitions || 0;
    document.getElementById('homeStatWinners').textContent = data.totalWinners || 0;
    document.getElementById('homeStatActive').textContent = data.activeNow || 0;

    // Latest winner
    const winners = await db.collection('competitions')
      .where('status', '==', 'completed')
      .where('winnerId', '!=', null)
      .orderBy('winnerId')
      .orderBy('completedAt', 'desc')
      .limit(1)
      .get();

    if (!winners.empty) {
      const w = winners.docs[0].data();
      document.getElementById('latestWinnerSection').style.display = 'block';
      document.getElementById('latestWinnerBanner').innerHTML = `
        <div class="winner-trophy">🏆</div>
        <div class="winner-name">${escHtml(w.winnerName || 'Unknown')}</div>
        <div class="text-muted text-xs mt-8">Won ${escHtml(w.planName || '')} — Competition #${w.compId || ''}</div>
        <div class="winner-coins">🪙 ${w.prizeCoins || 0} Prize Points</div>
      `;
    }
  } catch(e) {
    console.log('Stats error', e);
  }
}

// ===================== LOAD PUBLIC PLANS =====================
async function loadPublicPlans() {
  const container = document.getElementById('homePlansList');
  try {
    const snap = await db.collection('plans').orderBy('order').get();
    if (snap.empty) { container.innerHTML = '<div class="text-muted text-center">No plans available yet.</div>'; return; }
    container.innerHTML = '';
    snap.forEach(doc => {
      const p = doc.data();
      container.appendChild(buildPlanCard(doc.id, p, false));
    });
  } catch(e) {
    container.innerHTML = '<div class="text-muted text-center">Could not load plans.</div>';
  }
}

// ===================== LOAD COMPETITIONS (LOGGED IN) =====================
async function loadCompetitions() {
  const container = document.getElementById('competitionsList');
  try {
    const snap = await db.collection('competitions')
      .where('status', 'in', ['open', 'pending'])
      .orderBy('createdAt', 'desc')
      .get();

    if (snap.empty) {
      container.innerHTML = '<div class="card text-center"><div class="empty-icon">🎯</div><div class="text-muted">No competitions open right now. Check back soon!</div></div>';
      return;
    }
    container.innerHTML = '';
    snap.forEach(doc => {
      const c = doc.data();
      container.appendChild(buildCompCard(doc.id, c));
    });
  } catch(e) {
    container.innerHTML = '<div class="text-muted">Could not load competitions.</div>';
  }
}

function buildPlanCard(id, p, clickable) {
  const div = document.createElement('div');
  div.className = 'plan-card' + (p.featured ? ' featured' : '');
  const pct = Math.min(100, ((p.participants || 0) / 20) * 100);
  div.innerHTML = `
    <div class="plan-header">
      <div>
        <div class="plan-name">${escHtml(p.name)}</div>
        <div class="plan-prize">${escHtml(p.prizeDisplay || '')}</div>
      </div>
      <span class="plan-badge ${p.status === 'open' ? 'open' : p.status === 'closed' ? 'closed' : 'pending'}">${p.status || 'open'}</span>
    </div>
    <div class="plan-meta">
      <span>👥 ${p.participants || 0}/20 joined</span>
      <span>🧠 Quiz-based</span>
    </div>
    <div class="plan-progress-bar"><div class="plan-progress-fill" style="width:${pct}%"></div></div>
    ${clickable ? '' : '<div class="text-muted text-xs" style="margin-top:8px">Login to participate</div>'}
  `;
  if (clickable) div.onclick = () => promptJoin(id, p);
  return div;
}

function buildCompCard(id, c) {
  const div = document.createElement('div');
  div.className = 'plan-card' + (c.featured ? ' featured' : '');
  const pct = Math.min(100, ((c.participantCount || 0) / 20) * 100);
  const alreadyJoined = c.participantIds && c.participantIds.includes(currentUser?.uid);
  div.innerHTML = `
    <div class="plan-header">
      <div>
        <div class="plan-name">${escHtml(c.planName || 'Competition')}</div>
        <div class="plan-prize">${escHtml(c.prizeDisplay || '')}</div>
      </div>
      <span class="plan-badge ${c.status}">${c.status}</span>
    </div>
    <div class="plan-meta">
      <span>👥 ${c.participantCount || 0}/20</span>
      <span>🆔 #${c.compId || id.substr(0,6)}</span>
    </div>
    <div class="plan-progress-bar"><div class="plan-progress-fill" style="width:${pct}%"></div></div>
    <div class="mt-12">
      ${alreadyJoined
        ? `<span class="badge badge-green">✓ Joined — Ticket: ${c.participantTickets?.[currentUser?.uid] || '------'}</span>`
        : (c.status === 'open' && (c.participantCount || 0) < 20
          ? `<button class="btn btn-primary btn-sm" onclick="promptJoin('${id}',${JSON.stringify(c).replace(/"/g,"'")})">Join Competition</button>`
          : `<span class="badge badge-red">Full / Closed</span>`
        )
      }
    </div>
  `;
  return div;
}

// ===================== JOIN COMPETITION =====================
function promptJoin(compId, comp) {
  if (!currentUser) { showAuthPage('login'); showPage('auth'); return; }
  const modal = document.getElementById('joinModalContent');
  modal.innerHTML = `
    <div class="card-sm" style="background:rgba(108,63,197,0.1);border-color:var(--purple2)">
      <div class="plan-name">${escHtml(comp.planName || comp.name)}</div>
      <div class="plan-prize">${escHtml(comp.prizeDisplay || '')}</div>
    </div>
    <div class="text-muted mt-12" style="font-size:14px;line-height:1.6">
      By joining, you'll receive a unique six-digit ticket number. When 20 participants join, the round closes and a skill-based quiz will determine the winner.<br><br>
      <strong style="color:var(--gold)">Prize points are simulated promotional rewards — not real cash.</strong>
    </div>
    <div class="flex gap-8 mt-16">
      <button class="btn btn-outline" style="flex:1" onclick="closeModal('joinModal')">Cancel</button>
      <button class="btn btn-primary" style="flex:1" onclick="doJoin('${compId}')">Confirm Join</button>
    </div>
  `;
  openModal('joinModal');
}

async function doJoin(compId) {
  closeModal('joinModal');
  if (!currentUser) return;
  try {
    const compRef = db.collection('competitions').doc(compId);
    const compSnap = await compRef.get();
    if (!compSnap.exists) { showToast('Competition not found.', 'error'); return; }
    const comp = compSnap.data();

    if (comp.participantIds?.includes(currentUser.uid)) { showToast('You already joined this competition.'); return; }
    if ((comp.participantCount || 0) >= 20) { showToast('This competition is full.', 'error'); return; }
    if (comp.status !== 'open') { showToast('Competition is not open.', 'error'); return; }

    // Generate unique ticket
    let ticket;
    let unique = false;
    while (!unique) {
      ticket = generateTicketNumber();
      if (!(comp.usedTickets || []).includes(ticket)) unique = true;
    }

    const newCount = (comp.participantCount || 0) + 1;
    const updateData = {
      participantCount: firebase.firestore.FieldValue.increment(1),
      participantIds: firebase.firestore.FieldValue.arrayUnion(currentUser.uid),
      usedTickets: firebase.firestore.FieldValue.arrayUnion(ticket),
      [`participantTickets.${currentUser.uid}`]: ticket
    };

    if (newCount >= 20) {
      updateData.status = 'pending';
    }

    await compRef.update(updateData);

    // Add to user's ticket history
    await db.collection('tickets').add({
      userId: currentUser.uid,
      competitionId: compId,
      ticketNumber: ticket,
      planName: comp.planName,
      prizeDisplay: comp.prizeDisplay,
      joinedAt: firebase.firestore.FieldValue.serverTimestamp(),
      status: 'active'
    });

    // Update user entry count
    await db.collection('users').doc(currentUser.uid).update({
      totalEntries: firebase.firestore.FieldValue.increment(1)
    });

    showToast(`Joined! Your ticket: ${ticket} 🎫`, 'success');
    loadCompetitions();
    loadMyTickets();

    // Add notification
    await db.collection('notifications').add({
      userId: currentUser.uid,
      title: `Ticket ${ticket} issued`,
      body: `You joined ${comp.planName}. Good luck!`,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      read: false
    });

  } catch(e) {
    console.error(e);
    showToast('Could not join. Try again.', 'error');
  }
}

// ===================== MY TICKETS =====================
async function loadMyTickets() {
  const container = document.getElementById('myTicketsList');
  if (!currentUser) return;
  try {
    const snap = await db.collection('tickets')
      .where('userId', '==', currentUser.uid)
      .orderBy('joinedAt', 'desc')
      .get();

    if (snap.empty) {
      container.innerHTML = `<div class="empty"><div class="empty-icon">🎫</div>No tickets yet.<br><br><button class="btn btn-primary btn-sm" onclick="switchTab('competitions','comps')">Browse Competitions</button></div>`;
      return;
    }

    container.innerHTML = '';
    snap.forEach(doc => {
      const t = doc.data();
      const div = document.createElement('div');
      div.className = 'ticket';
      div.innerHTML = `
        <div>
          <div class="ticket-num">${t.ticketNumber}</div>
          <div class="text-muted text-xs">${t.planName}</div>
          <div class="text-xs" style="color:var(--text3)">${formatDate(t.joinedAt)}</div>
        </div>
        <div class="ticket-info">
          <div class="ticket-plan">${t.prizeDisplay}</div>
          <span class="badge badge-${t.won ? 'gold' : t.status === 'active' ? 'green' : 'purple'}">${t.won ? '🏆 Won' : t.status}</span>
        </div>
      `;
      container.appendChild(div);
    });
  } catch(e) {
    container.innerHTML = '<div class="text-muted">Could not load tickets.</div>';
  }
}

// ===================== PROFILE =====================
async function loadProfile() {
  if (!currentUser || !currentUserData) return;
  const d = currentUserData;
  // Re-fetch fresh data
  const snap = await db.collection('users').doc(currentUser.uid).get();
  const fresh = snap.data();
  document.getElementById('profileAvatar').textContent = (fresh.name || 'P')[0].toUpperCase();
  document.getElementById('profileName').textContent = fresh.name || '—';
  document.getElementById('profilePhone').textContent = fresh.phone || '—';
  document.getElementById('profileUID').textContent = fresh.playerId || '—';
  document.getElementById('profileCoins').textContent = `🪙 ${fresh.coins || 0} Coins`;

  // Competition history
  const histSnap = await db.collection('tickets')
    .where('userId', '==', currentUser.uid)
    .orderBy('joinedAt', 'desc')
    .limit(10)
    .get();

  const histEl = document.getElementById('compHistory');
  if (histSnap.empty) {
    histEl.innerHTML = '<div class="text-muted text-xs mt-8">No competitions entered yet.</div>';
  } else {
    histEl.innerHTML = '';
    histSnap.forEach(doc => {
      const t = doc.data();
      histEl.innerHTML += `
        <div class="history-row">
          <div><div style="font-size:14px;font-weight:600">${escHtml(t.planName)}</div><div class="text-xs text-muted">${formatDate(t.joinedAt)}</div></div>
          <div><div class="text-xs text-right">${t.ticketNumber}</div><span class="badge badge-${t.won ? 'gold' : 'purple'}">${t.won ? 'Won' : 'Entered'}</span></div>
        </div>`;
    });
  }
}

function copyUID() {
  const uid = document.getElementById('profileUID').textContent;
  navigator.clipboard.writeText(uid).then(() => showToast('Player ID copied!', 'success'));
}

// ===================== NOTIFICATIONS =====================
async function loadNotifications() {
  if (!currentUser) return;
  const container = document.getElementById('notifList');
  try {
    const snap = await db.collection('notifications')
      .where('userId', '==', currentUser.uid)
      .orderBy('createdAt', 'desc')
      .limit(10)
      .get();

    if (snap.empty) {
      container.innerHTML = '<div class="text-muted text-xs mt-8">No notifications.</div>';
      return;
    }
    container.innerHTML = '';
    snap.forEach(doc => {
      const n = doc.data();
      container.innerHTML += `
        <div class="notif ${n.read ? '' : 'unread'}">
          <div class="notif-title">${escHtml(n.title)}</div>
          <div class="text-muted text-xs">${escHtml(n.body)}</div>
          <div class="notif-time">${formatDate(n.createdAt)}</div>
        </div>`;
    });
    // Mark all read
    snap.forEach(doc => {
      if (!doc.data().read) doc.ref.update({ read: true });
    });
  } catch(e) {}
}

// ===================== QUIZ =====================
const quizQuestions = [
  { q: "What is 15 × 8?", opts: ["120","110","130","140"], ans: 0 },
  { q: "Which planet is closest to the Sun?", opts: ["Venus","Earth","Mercury","Mars"], ans: 2 },
  { q: "What is the capital of France?", opts: ["London","Berlin","Paris","Rome"], ans: 2 },
  { q: "What is 144 ÷ 12?", opts: ["10","11","12","14"], ans: 2 },
  { q: "Which gas do plants absorb?", opts: ["Oxygen","Nitrogen","CO₂","Hydrogen"], ans: 2 },
  { q: "How many sides does a hexagon have?", opts: ["5","6","7","8"], ans: 1 },
  { q: "What is 7²?", opts: ["42","47","49","51"], ans: 2 },
  { q: "Who wrote Romeo and Juliet?", opts: ["Dickens","Shakespeare","Hemingway","Austen"], ans: 1 },
  { q: "Speed of light (approx.) in km/s?", opts: ["200,000","300,000","400,000","500,000"], ans: 1 },
  { q: "What is the square root of 256?", opts: ["14","15","16","17"], ans: 2 }
];

let quizState = { idx: 0, score: 0, questions: [], compId: null, done: false };

function startQuiz(compId) {
  const shuffled = [...quizQuestions].sort(() => Math.random() - 0.5).slice(0, 5);
  quizState = { idx: 0, score: 0, questions: shuffled, compId, done: false };
  renderQuizQuestion();
  openModal('quizModal');
}

function renderQuizQuestion() {
  const q = quizState.questions[quizState.idx];
  document.getElementById('quizContent').innerHTML = `
    <div class="text-muted text-xs" style="margin-bottom:8px">Question ${quizState.idx + 1} of ${quizState.questions.length}</div>
    <div style="font-size:17px;font-weight:600;margin-bottom:16px;line-height:1.4">${escHtml(q.q)}</div>
    ${q.opts.map((o, i) => `<div class="quiz-option" onclick="selectAnswer(${i})">${escHtml(o)}</div>`).join('')}
  `;
}

function selectAnswer(idx) {
  if (quizState.done) return;
  const q = quizState.questions[quizState.idx];
  const opts = document.querySelectorAll('.quiz-option');
  opts.forEach((o, i) => {
    if (i === q.ans) o.classList.add('correct');
    else if (i === idx && i !== q.ans) o.classList.add('wrong');
    o.style.pointerEvents = 'none';
  });
  if (idx === q.ans) quizState.score++;

  setTimeout(() => {
    quizState.idx++;
    if (quizState.idx < quizState.questions.length) {
      renderQuizQuestion();
    } else {
      quizState.done = true;
      showQuizResult();
    }
  }, 800);
}

function showQuizResult() {
  const pct = Math.round((quizState.score / quizState.questions.length) * 100);
  document.getElementById('quizContent').innerHTML = `
    <div class="text-center">
      <div class="quiz-score">${quizState.score}/${quizState.questions.length}</div>
      <div class="text-muted">Accuracy: ${pct}%</div>
      <div style="margin:16px 0;font-size:30px">${pct >= 80 ? '🏆' : pct >= 60 ? '👍' : '📚'}</div>
      <div style="font-size:15px;margin-bottom:16px">${pct >= 80 ? 'Excellent! Great shot at winning.' : pct >= 60 ? 'Good effort! Results after admin review.' : 'Keep practising for next round!'}</div>
      <button class="btn btn-primary btn-block" onclick="submitQuizResult()">Submit Score</button>
    </div>
  `;
}

async function submitQuizResult() {
  if (!currentUser) return;
  try {
    await db.collection('quizResults').add({
      userId: currentUser.uid,
      userName: currentUserData?.name || 'Player',
      competitionId: quizState.compId,
      score: quizState.score,
      total: quizState.questions.length,
      submittedAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    showToast('Score submitted! Awaiting admin verification.', 'success');
    closeModal('quizModal');
  } catch(e) {
    showToast('Could not submit. Try again.', 'error');
  }
}

// ===================== SUPPORT =====================
const supportContent = {
  faq: {
    title: 'FAQs',
    body: `
      <div class="text-muted" style="font-size:14px;line-height:1.7">
        <strong style="color:var(--text)">What are prize points?</strong><br>
        Prize points are simulated, non-cash promotional rewards. They are not real money.<br><br>
        <strong style="color:var(--text)">How is the winner chosen?</strong><br>
        The player with the highest quiz score wins. Admin verifies and publishes results.<br><br>
        <strong style="color:var(--text)">Can I join multiple competitions?</strong><br>
        Yes! You can join any open competition.<br><br>
        <strong style="color:var(--text)">Is my data safe?</strong><br>
        Yes. We use Firebase Authentication and never store plain-text passwords. We do not collect bank, UPI, or card details.
      </div>
    `
  },
  contact: {
    title: 'Contact Us',
    body: `
      <div class="text-muted" style="font-size:14px;line-height:1.7">
        For support, email us at:<br>
        <strong style="color:var(--purple2)">support@luckyticket.app</strong><br><br>
        Response time: within 24 hours on business days.
      </div>
    `
  },
  rules: {
    title: 'Competition Rules',
    body: `
      <div class="text-muted" style="font-size:14px;line-height:1.7">
        1. Each competition allows exactly 20 participants.<br><br>
        2. Each participant receives one unique six-digit ticket.<br><br>
        3. When 20 players join, the round closes automatically.<br><br>
        4. A skill-based quiz is then made available.<br><br>
        5. The player with the highest score wins virtual prize points.<br><br>
        6. Results are verified and published by the admin.<br><br>
        7. Prize points are promotional and non-transferable.<br><br>
        8. No cash, UPI, or card payments are involved.
      </div>
    `
  }
};

function showSupport(type) {
  document.getElementById('supportModalTitle').textContent = supportContent[type].title;
  document.getElementById('supportModalContent').innerHTML = supportContent[type].body;
  openModal('supportModal');
}

// ===================== UTILS =====================
function escHtml(str) {
  return String(str || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function formatDate(ts) {
  if (!ts) return '';
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
}

// Close modals on overlay click
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', e => {
    if (e.target === overlay) overlay.classList.remove('show');
  });
});

// Real-time listener for competition updates
function setupRealtimeListeners() {
  if (!currentUser) return;
  db.collection('competitions')
    .where('status', 'in', ['open', 'pending'])
    .onSnapshot(() => {
      if (activeTab === 'comps') loadCompetitions();
    });
}
</script>
</body>
</html>
